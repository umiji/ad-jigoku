{
  "name": "@ad-jigoku/pattern-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Kernel: パターンカタログのスキーマ・データ・クエリ API（他の何にも依存しない / ADR-001）",
