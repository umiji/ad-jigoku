    "severity": 12,
    "severitySource": "hypothesis",
    "gameDifficulty": 2,
    "dimensions": { "interruption": 2, "obstruction": 3, "interactionFriction": 1, "timeCost": 1, "mobileImpact": 3 },
    "game": {
