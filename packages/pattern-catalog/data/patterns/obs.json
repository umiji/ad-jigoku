      "recommendations": [
        { "ja": "オーバーレイの占有面積を viewport の 30% 以下に抑える。", "effort": "medium", "expectedSeverityReduction": 6 },
        { "ja": "ページ遷移の境界（記事から記事へ移る瞬間）にのみ表示する。", "effort": "medium", "expectedSeverityReduction": 3 }
      ],
      "adFriendlyAlternative": { "ja": "全画面をやめ、本文と競合しないアンカー枠やインライン枠に同じクリエイティブを出す。占有率を下げても視認は成立する。" }
    }
