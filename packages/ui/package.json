{
  "name": "@ad-jigoku/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "デザイントークン + canonical components + shells（DESIGN.md の唯一の実体。game-engine 依存禁止）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./tokens/index.ts",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "tokens:build": "tsx tokens/build-css.ts",
    "tokens:check": "tsx tokens/build-css.ts --check",
    "lint": "pnpm -w exec eslint packages/ui",
    "test": "vitest run"
  },
  "dependencies": {
    "@ad-jigoku/pattern-catalog": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
